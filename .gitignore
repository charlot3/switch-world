data/
*.sqlite
*.sqlite-journal
*.sqlite-wal
logs/

# python
.venv/
__pycache__/
*.pyc

# node (dashboard build, if any)
node_modules/

# recordings and local scratch
recordings/
scratch/

# macOS
.DS_Store
