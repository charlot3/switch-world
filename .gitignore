.env
.env.*
!.env.example

# Switch Console writes credentials/settings here
.switch/

# Generated per-agent configs contain literal tokens
agents/*/opencode.json
agents/*/.mcp.json

# Fetched Switch compose artifact
deploy/switch/

# world engine state, exports and logs
data/
*.sqlite
*.sqlite-journal
*.sqlite-wal
logs/

# Bifrost runtime state; keep the checked-in config only
!deploy/bifrost/data/
deploy/bifrost/data/*
!deploy/bifrost/data/config.json

# python
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# node (dashboard build, if any)
node_modules/

# recordings and local scratch
recordings/
scratch/

# macOS
.DS_Store

# Generated demo media stays local; GitHub does not need 200 MB of cuts.
docs/*.mp4
docs/*.wav
docs/*-poster.jpg
docs/setsuna-audition/
deploy/demo/data/
