# ---- Switch self-host -------------------------------------------------------
SWITCH_VERSION=changeme-pinned-tag
COMPOSE_PROFILES=collab,gateway
ID_SERVER_NAME=switch-world-local
SWITCH_BIND_ADDR=127.0.0.1
# Despite the name: the public address of the Switch API, not the Gateway.
GATEWAY_PUBLIC_URL=http://localhost:8000

# Deployment bootstrap key. Do NOT use this to register the director.
AGENT_REGISTRATION_TOKEN=changeme
# A registration key created in the Gateway under YOUR account. Use this for the director.
SWITCH_REGISTRATION_KEY=changeme

SECRET_KEYS=primary:changeme-32-plus-character-secret
GATEWAY_ADMIN_EMAIL=admin@switch.local
GATEWAY_ADMIN_PASSWORD=changeme

# Postgres (the standalone compose needs these; the official sample/generator fills them)
DB_USER=switch_app
DB_PASSWORD=changeme
DB_OWNER_USER=postgres
DB_OWNER_PASSWORD=changeme
DB_NAME=switch

# Bundled Mattermost
MATTERMOST_ADMIN_USER=admin
MATTERMOST_ADMIN_PASSWORD=changeme
MATTERMOST_TEAM_NAME=switch
MATTERMOST_USER=user
MATTERMOST_USER_PASSWORD=changeme

# ---- Switch API used by the director ---------------------------------------
SWITCH_API=http://127.0.0.1:8000
DIRECTOR_AGENT_ID=changeme
DIRECTOR_API_KEY=changeme
# The #world room id, filled in after the channel is created.
WORLD_ROOM_ID=changeme

# ---- World engine ----------------------------------------------------------
WORLD_ENGINE_URL=http://127.0.0.1:8890
WORLD_MCP_URL=http://127.0.0.1:8890/mcp
WORLD_ENGINE_HOST=127.0.0.1
WORLD_ENGINE_PORT=8890
WORLD_DB=data/world.sqlite
# The OpenCode model used by every character. Keep it identical across the cast.
WORLD_AGENT_MODEL=opencode-go/deepseek-v4.1-flash
# Auxiliary OpenCode calls (title/summary) must not fall back to a provider default.
WORLD_AGENT_SMALL_MODEL=opencode-go/deepseek-v4.1-flash

# One scoped token per character; the server maps token -> character id.
# scripts/render-agent-configs.sh writes these literals into agents/<name>/opencode.json.
WORLD_TOKEN_ALICE=changeme
WORLD_TOKEN_EMILY=changeme
WORLD_TOKEN_SOPHIA=changeme
WORLD_TOKEN_MIA=changeme
WORLD_TOKEN_DIRECTOR=changeme

# ---- Geek Room layer -------------------------------------------------------
# Bifrost (Maxim AI) OpenAI-compatible gateway. scripts/run-bifrost.sh starts it
# plus the OpenCode Go adapter on :8090. The adapter calls the free OpenCode model
# already signed in on this machine; no paid provider key is needed.
BIFROST_URL=http://127.0.0.1:8080/v1
BIFROST_API_KEY=dummy
BIFROST_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef
OLLAMA_URL=http://host.docker.internal:11435
OPENCODE_PROXY_TOKEN=opencode-shim
OPENCODE_MODEL=opencode-go/deepseek-v4.1-flash
OPENCODE_GATEWAY_PORT=8090
OPENCODE_TIMEOUT=240
# Optional per-character provider models; leave unset to use world/models.json.
# BIFROST_MODEL_ALICE=anthropic/claude-sonnet-4-5
# BIFROST_FALLBACKS_ALICE=openai/gpt-4o-mini,ollama/qwen3.8:27b-q4_K_M
# BIFROST_VK_ALICE=changeme

# Tavily: set the key for live retrieval. TAVILY_OFFLINE=1 uses the clearly-labelled
# local fixture for a no-network demo.
TAVILY_API_KEY=
TAVILY_OFFLINE=0
WORLD_NEWS_QUERY=AI agents, creative tools and human-agent collaboration news this week
